<!doctype html>
<html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="canonical" href="{{ canonical_url }}"><title>{{ page_title | escape }} | {{ shop.name | escape }}</title><link rel="icon" href="https://www.jiyuskin.com/cdn/shop/files/favicon.png?crop=center&amp;height=32&amp;v=1763227417&amp;width=32" type="image/png" sizes="32x32"><style>#tab-1 > .faq-item:first-of-type,#tab-6 > .faq-item:first-of-type,#tab-6 > .faq-item:last-of-type,.jiyu-footer__social,.faq-item a[href="https://www.jiyuskin.com/customer_authentication/redirect"]{display:none!important}</style>{{ content_for_header }}{{ 'jiyu.css' | asset_url | stylesheet_tag }}</head><body>
{% assign toner_handle = settings.toner_product | default: 'renewal-rejuvenation-toner-pads' %}{% assign cream_handle = settings.cream_product | default: 'anti-aging-moisturizing-cream' %}{% assign bundle_handle = settings.bundle_product | default: 'anti-aging-glow-up-bundle' %}{% assign toner = all_products[toner_handle] %}{% assign cream = all_products[cream_handle] %}{% assign bundle = all_products[bundle_handle] %}
<script>window.JIYU_THEME={assetBase:{{ 'jiyu.js' | asset_url | split: '?' | first | remove: 'jiyu.js' | json }},root:{{ routes.root_url | json }},accountUrl:{{ routes.account_url | json }},products:{toner:{{ toner | json }},cream:{{ cream | json }},bundle:{{ bundle | json }}}};window.JIYU_THEME.resolveAssetText=function(text){text=text.replaceAll('/assets/nav-04024a0db1243bee','/assets/nav-04024a0db1243bee.jpg');text=text.replaceAll('/assets/nav-59a4fe69a2e2129c','/assets/nav-59a4fe69a2e2129c.jpg');text=text.replaceAll('/assets/nav-687610b252848e05','/assets/nav-687610b252848e05.jpg');text=text.replaceAll('/assets/nav-7cd1d9324f72c423','/assets/nav-7cd1d9324f72c423.jpg');text=text.replaceAll('/assets/nav-ca9a831e9bf989ea','/assets/nav-ca9a831e9bf989ea.jpg');text=text.replaceAll('/assets/nav-de64769438065a0e','/assets/nav-de64769438065a0e.jpg');return text.replace(/\/assets\/(video\/|source\/|videos\/)?/g,function(_,folder){return folder==='video/'?"https://raw.githubusercontent.com/mohannadabuhdeib-art/shopify1/399b5e6fe6db8122131f712ada962a0cde3c8f6f/public/assets/video/":window.JIYU_THEME.assetBase+(folder?folder.replace('/','-'):'')})};</script>
{{ content_for_layout }}
<script>(function(){function setHidden(form,name,value){var input=form.querySelector('input[name="'+name+'"]');if(!input){input=document.createElement('input');input.type='hidden';input.name=name;form.prepend(input)}input.value=value;input.setAttribute('value',value)}function connectNewsletter(form){form=form||document.getElementById('ContactFooter');if(!form)return;form.method='post';form.action='{{ routes.root_url }}contact#ContactFooter';setHidden(form,'form_type','customer');setHidden(form,'utf8','✓');setHidden(form,'contact[tags]','newsletter');var email=form.querySelector('input[type="email"],input[name="contact[email]"]');if(email){email.name='contact[email]';email.required=true;email.autocomplete='email'}}function scan(){connectNewsletter()}document.addEventListener('submit',function(event){if(event.target&&event.target.id==='ContactFooter')connectNewsletter(event.target)},true);new MutationObserver(scan).observe(document.documentElement,{childList:true,subtree:true});scan();setTimeout(scan,500);setTimeout(scan,1500)})();</script>
<script src="{{ 'videos-hls.min.js' | asset_url }}" defer></script><script src="{{ 'jiyu.js' | asset_url }}" defer></script></body></html>

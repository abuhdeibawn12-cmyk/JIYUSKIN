<!doctype html>
<html lang="{{ request.locale.iso_code }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="canonical" href="{{ canonical_url }}"><title>{{ page_title | escape }} | {{ shop.name | escape }}</title><link rel="icon" href="https://www.jiyuskin.com/cdn/shop/files/favicon.png?crop=center&amp;height=32&amp;v=1763227417&amp;width=32" type="image/png" sizes="32x32"><style>#tab-1 > .faq-item:first-of-type,#tab-6 > .faq-item:first-of-type,#tab-6 > .faq-item:last-of-type,.jiyu-footer__social,.faq-item a[href="https://www.jiyuskin.com/customer_authentication/redirect"],#section-template--19982205124687__about_us_faq_qGN6mM .faq-column--left > .faq-item:first-of-type,#section-template--19982205124687__about_us_faq_qGN6mM .faq-column--left > .faq-item:last-of-type,.video-cta{display:none!important}</style>{{ content_for_header }}{{ 'jiyu.css' | asset_url | stylesheet_tag }}{{ 'account-drawer.css' | asset_url | stylesheet_tag }}{{ 'tracking-page.css' | asset_url | stylesheet_tag }}</head><body{% if request.path contains '/apps/parcelpanel' %} class="j-tracking-route"{% endif %}>
{% assign toner_handle = settings.toner_product | default: 'renewal-rejuvenation-toner-pads' %}{% assign cream_handle = settings.cream_product | default: 'anti-aging-moisturizing-cream' %}{% assign bundle_handle = settings.bundle_product | default: 'anti-aging-glow-up-bundle' %}{% assign toner = all_products[toner_handle] %}{% assign cream = all_products[cream_handle] %}{% assign bundle = all_products[bundle_handle] %}
<script>window.JIYU_THEME={assetBase:{{ 'jiyu.js' | asset_url | split: '?' | first | remove: 'jiyu.js' | json }},root:{{ routes.root_url | json }},accountUrl:{{ routes.account_url | json }},products:{toner:{{ toner | json }},cream:{{ cream | json }},bundle:{{ bundle | json }}}};window.JIYU_THEME.resolveAssetText=function(text){text=text.replaceAll('/assets/nav-04024a0db1243bee','/assets/nav-04024a0db1243bee.jpg');text=text.replaceAll('/assets/nav-59a4fe69a2e2129c','/assets/nav-59a4fe69a2e2129c.jpg');text=text.replaceAll('/assets/nav-687610b252848e05','/assets/nav-687610b252848e05.jpg');text=text.replaceAll('/assets/nav-7cd1d9324f72c423','/assets/nav-7cd1d9324f72c423.jpg');text=text.replaceAll('/assets/nav-ca9a831e9bf989ea','/assets/nav-ca9a831e9bf989ea.jpg');text=text.replaceAll('/assets/nav-de64769438065a0e','/assets/nav-de64769438065a0e.jpg');return text.replace(/\/assets\/(video\/|source\/|videos\/)?/g,function(_,folder){return folder==='video/'?"https://raw.githubusercontent.com/mohannadabuhdeib-art/shopify1/399b5e6fe6db8122131f712ada962a0cde3c8f6f/public/assets/video/":window.JIYU_THEME.assetBase+(folder?folder.replace('/','-'):'')})};</script>
{% if request.path contains '/apps/parcelpanel' %}
  <a class="j-tracking-skip" href="#pp-tracking-page-app">Skip to order tracking</a>
  <div class="j-tracking-shell">
    <header class="j-tracking-header">
      <a class="j-tracking-logo" href="{{ routes.root_url }}" aria-label="JIYU home">
        <img src="{{ '5f469f939df6e349.png' | asset_url }}" alt="JIYU" width="92" height="52">
      </a>
      <nav class="j-tracking-nav" aria-label="Tracking page navigation">
        <a href="/collections/all-products">Shop</a>
        <a href="{{ routes.account_url }}">Account</a>
      </nav>
    </header>
    <main class="j-tracking-main">
      <div class="j-tracking-intro">
        <p class="j-tracking-eyebrow">Order support</p>
        <h1>Track Your Order</h1>
        <p>Enter your order details or tracking number for the latest delivery updates.</p>
      </div>
      <div class="j-tracking-widget">
        {{ content_for_layout }}
      </div>
      <div class="j-tracking-assurances" aria-label="Tracking benefits">
        <div class="j-tracking-assurance"><strong>Secure lookup</strong><span>Your order details stay protected.</span></div>
        <div class="j-tracking-assurance"><strong>Real-time updates</strong><span>Follow every step from dispatch to delivery.</span></div>
        <div class="j-tracking-assurance"><strong>Global carrier coverage</strong><span>Tracking across 1,600+ delivery carriers.</span></div>
      </div>
    </main>
    <footer class="j-tracking-footer">
      <span>JIYU (operated by Living Earth LLC), {{ 'now' | date: '%Y' }}</span>
      <div class="j-tracking-footer-links">
        <a href="/pages/faq-page">FAQ</a>
        <a href="/pages/privacy-policy">Privacy</a>
        <a href="/pages/refund-return-policy-1">Returns</a>
      </div>
    </footer>
  </div>
{% else %}
  {{ content_for_layout }}
{% endif %}
<script>(function(){function upgradeNewsletter(){var current=document.getElementById('ContactFooter');if(!current)return;var formType=current.querySelector('input[name="form_type"]'),utf8=current.querySelector('input[name="utf8"]'),tags=current.querySelector('input[name="contact[tags]"]');if(current.dataset.shopifyNative==='true'&&formType&&formType.value==='customer'&&utf8&&utf8.value==='✓'&&tags&&tags.value==='newsletter')return;var form=current.cloneNode(true);form.dataset.shopifyNative='true';form.method='post';form.action='{{ routes.root_url }}contact#ContactFooter';function setHidden(name,value){var input=form.querySelector('input[name="'+name+'"]');if(!input){input=document.createElement('input');input.type='hidden';input.name=name;form.prepend(input)}input.value=value;input.setAttribute('value',value)}setHidden('form_type','customer');setHidden('utf8','✓');setHidden('contact[tags]','newsletter');var email=form.querySelector('input[type="email"],input[name="contact[email]"]');if(email){email.name='contact[email]';email.required=true;email.autocomplete='email'}current.replaceWith(form)}var queued=false;function queueUpgrade(){if(queued)return;queued=true;setTimeout(function(){queued=false;upgradeNewsletter()},0)}new MutationObserver(queueUpgrade).observe(document.documentElement,{childList:true,subtree:true,attributes:true});queueUpgrade();setTimeout(upgradeNewsletter,500);setTimeout(upgradeNewsletter,1500)})();</script>
<script src="{{ 'videos-hls.min.js' | asset_url }}" defer></script><script src="{{ 'jiyu.js' | asset_url }}" defer></script><script src="{{ 'account-drawer.js' | asset_url }}" defer></script></body></html>

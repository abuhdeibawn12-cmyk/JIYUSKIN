{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0a6b3f">
    <title>Your cart — {{ shop.name | escape }}</title>
    <link rel="icon" href="{{ '5f469f939df6e349.png' | asset_url }}" type="image/png">
    {{ content_for_header }}
    <style>
      :root {
        --jiyu-green: #0a6b3f;
        --jiyu-green-dark: #075232;
        --jiyu-cream: #fbf7ed;
        --jiyu-mint: #e8f2df;
        --jiyu-ink: #173126;
        --jiyu-muted: #68756f;
        --jiyu-line: #dbe4dc;
        --jiyu-white: #ffffff;
      }
      * { box-sizing: border-box; }
      body { margin: 0; color: var(--jiyu-ink); background: var(--jiyu-cream); font-family: Arial, Helvetica, sans-serif; -webkit-font-smoothing: antialiased; }
      a { color: inherit; }
      .site-header { background: var(--jiyu-white); border-bottom: 1px solid var(--jiyu-line); }
      .site-header__inner { width: min(1180px, calc(100% - 40px)); min-height: 82px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
      .brand { display: inline-flex; align-items: center; }
      .brand img { display: block; width: 126px; height: auto; }
      .continue-link { display: inline-flex; align-items: center; gap: 8px; color: var(--jiyu-green); font-size: 14px; font-weight: 700; text-decoration: none; }
      .continue-link:hover { text-decoration: underline; }
      .cart-shell { width: min(1180px, calc(100% - 40px)); margin: 0 auto; padding: 60px 0 80px; }
      .eyebrow { margin: 0 0 10px; color: var(--jiyu-green); font-size: 12px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
      h1 { margin: 0; color: var(--jiyu-green-dark); font-family: Georgia, 'Times New Roman', serif; font-size: clamp(40px, 6vw, 66px); line-height: 1; letter-spacing: -.035em; }
      .cart-count { margin: 14px 0 40px; color: var(--jiyu-muted); font-size: 15px; }
      .cart-grid { display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 32px; align-items: start; }
      .cart-items { overflow: hidden; background: var(--jiyu-white); border: 1px solid var(--jiyu-line); border-radius: 22px; box-shadow: 0 14px 36px rgba(15, 74, 47, .06); }
      .cart-item { display: grid; grid-template-columns: 132px minmax(0, 1fr) auto; gap: 24px; padding: 24px; align-items: center; }
      .cart-item + .cart-item { border-top: 1px solid var(--jiyu-line); }
      .cart-item__image-wrap { display: block; overflow: hidden; aspect-ratio: 1; background: var(--jiyu-mint); border-radius: 16px; }
      .cart-item__image { width: 100%; height: 100%; display: block; object-fit: cover; }
      .cart-item__title { margin: 0 0 7px; color: var(--jiyu-green-dark); font-family: Georgia, 'Times New Roman', serif; font-size: 22px; line-height: 1.2; }
      .cart-item__title a { text-decoration: none; }
      .cart-item__title a:hover { text-decoration: underline; }
      .cart-item__meta { margin: 3px 0; color: var(--jiyu-muted); font-size: 13px; line-height: 1.45; }
      .subscription-pill { width: fit-content; margin: 10px 0 0; padding: 6px 10px; color: var(--jiyu-green-dark); background: var(--jiyu-mint); border-radius: 999px; font-size: 12px; font-weight: 700; }
      .cart-item__actions { min-width: 112px; display: flex; flex-direction: column; align-items: flex-end; gap: 14px; }
      .cart-item__price { color: var(--jiyu-green-dark); font-size: 17px; font-weight: 800; }
      .quantity-label { color: var(--jiyu-muted); font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
      .quantity-input { width: 74px; height: 42px; padding: 0 10px; color: var(--jiyu-ink); background: var(--jiyu-white); border: 1px solid #bfcfc3; border-radius: 10px; font: inherit; text-align: center; }
      .remove-link { color: var(--jiyu-muted); font-size: 12px; text-underline-offset: 3px; }
      .cart-summary { position: sticky; top: 24px; padding: 28px; background: var(--jiyu-green-dark); color: var(--jiyu-white); border-radius: 22px; box-shadow: 0 18px 40px rgba(7, 82, 50, .17); }
      .cart-summary h2 { margin: 0 0 24px; font-family: Georgia, 'Times New Roman', serif; font-size: 27px; }
      .summary-row { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; padding: 17px 0; border-top: 1px solid rgba(255, 255, 255, .22); }
      .summary-row strong { font-size: 24px; }
      .summary-note { margin: 0 0 22px; color: rgba(255, 255, 255, .78); font-size: 13px; line-height: 1.5; }
      .button { width: 100%; min-height: 52px; display: inline-flex; align-items: center; justify-content: center; border-radius: 999px; font: inherit; font-size: 15px; font-weight: 800; cursor: pointer; }
      .button--checkout { color: var(--jiyu-green-dark); background: var(--jiyu-white); border: 2px solid var(--jiyu-white); }
      .button--checkout:hover { background: var(--jiyu-mint); }
      .button--update { margin-top: 12px; color: var(--jiyu-white); background: transparent; border: 1px solid rgba(255, 255, 255, .55); }
      .button--update:hover { border-color: var(--jiyu-white); }
      .empty-cart { padding: 72px 24px; text-align: center; background: var(--jiyu-white); border: 1px solid var(--jiyu-line); border-radius: 22px; }
      .empty-cart h2 { margin: 0 0 10px; color: var(--jiyu-green-dark); font-family: Georgia, 'Times New Roman', serif; font-size: 30px; }
      .empty-cart p { margin: 0 0 24px; color: var(--jiyu-muted); }
      .empty-cart .button { width: auto; min-width: 210px; padding: 0 26px; color: var(--jiyu-white); background: var(--jiyu-green); border: 2px solid var(--jiyu-green); text-decoration: none; }
      @media (max-width: 820px) { .cart-shell { padding-top: 42px; } .cart-grid { grid-template-columns: 1fr; } .cart-summary { position: static; } }
      @media (max-width: 560px) {
        .site-header__inner, .cart-shell { width: min(100% - 24px, 1180px); }
        .site-header__inner { min-height: 70px; }
        .brand img { width: 106px; }
        .continue-link span { display: none; }
        .cart-shell { padding: 34px 0 50px; }
        .cart-count { margin-bottom: 26px; }
        .cart-item { grid-template-columns: 94px minmax(0, 1fr); gap: 16px; padding: 18px; align-items: start; }
        .cart-item__actions { grid-column: 1 / -1; width: 100%; min-width: 0; flex-direction: row; align-items: center; justify-content: space-between; padding-top: 2px; }
        .cart-item__price { order: 3; }
        .quantity-label { display: none; }
        .cart-summary { padding: 24px; }
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <a class="brand" href="{{ routes.root_url }}" aria-label="JIYU home">
          <img src="{{ '5f469f939df6e349.png' | asset_url }}" alt="JIYU" width="4001" height="1459">
        </a>
        <a class="continue-link" href="{{ routes.root_url }}"><span aria-hidden="true">←</span><span>Continue shopping</span></a>
      </div>
    </header>
    <main class="cart-shell">
      <p class="eyebrow">JIYU skincare</p>
      <h1>Your cart</h1>
      {% if cart.item_count > 0 %}
        <p class="cart-count">{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %} ready for checkout</p>
        <form action="{{ routes.cart_url }}" method="post">
          <div class="cart-grid">
            <section class="cart-items" aria-label="Items in your cart">
              {% for item in cart.items %}
                <article class="cart-item">
                  <a class="cart-item__image-wrap" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
                    {% if item.image %}
                      <img class="cart-item__image" src="{{ item.image | image_url: width: 320 }}" alt="{{ item.image.alt | default: item.product.title | escape }}" width="160" height="160" loading="lazy">
                    {% endif %}
                  </a>
                  <div class="cart-item__details">
                    <h2 class="cart-item__title"><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2>
                    {% unless item.product.has_only_default_variant %}<p class="cart-item__meta">{{ item.variant.title | escape }}</p>{% endunless %}
                    {% if item.selling_plan_allocation %}<p class="subscription-pill">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}
                  </div>
                  <div class="cart-item__actions">
                    <span class="cart-item__price">{{ item.final_line_price | money }}</span>
                    <label class="quantity-label" for="quantity-{{ forloop.index }}">Quantity</label>
                    <input class="quantity-input" id="quantity-{{ forloop.index }}" aria-label="Quantity for {{ item.product.title | escape }}" name="updates[]" type="number" min="0" value="{{ item.quantity }}">
                    <a class="remove-link" href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0">Remove</a>
                  </div>
                </article>
              {% endfor %}
            </section>
            <aside class="cart-summary" aria-label="Order summary">
              <h2>Order summary</h2>
              <div class="summary-row"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div>
              <p class="summary-note">Shipping and taxes are calculated at checkout. Subscription details can be reviewed before payment.</p>
              <button class="button button--checkout" type="submit" name="checkout">Secure checkout</button>
              <button class="button button--update" type="submit" name="update">Update cart</button>
            </aside>
          </div>
        </form>
      {% else %}
        <p class="cart-count">Your ritual is waiting.</p>
        <section class="empty-cart">
          <h2>Your cart is empty</h2>
          <p>Explore JIYU essentials and build your skincare ritual.</p>
          <a class="button" href="{{ routes.root_url }}">Shop JIYU</a>
        </section>
      {% endif %}
    </main>
  </body>
</html>
